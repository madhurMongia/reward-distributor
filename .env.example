# Private key for deployment (without 0x prefix)
# IMPORTANT: Never commit your actual private key to version control
PRIVATE_KEY=your_private_key_here

# ============================
# Sepolia Testnet Configuration
# ============================
# Public Sepolia RPC endpoint used by Hardhat.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# PNK token address on Sepolia testnet
SEPOLIA_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000

# CrossChainProofOfHumanity contract address on Sepolia
SEPOLIA_CCPOH_ADDRESS=0x0000000000000000000000000000000000000000

# ============================
# API Keys for Contract Verification
# ============================
# Etherscan API key (for Sepolia verification)
ETHERSCAN_API_KEY=your_etherscan_api_key

# Blockscout API key (optional for Chiado/Gnosis verification)
BLOCKSCOUT_API_KEY=abc123
