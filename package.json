{
  "name": "airdrop-router-hardhat",
  "version": "1.0.0",
  "description": "Airdrop Router Hardhat project with custom implementations",
  "main": "index.js",
  "scripts": {
    "test": "npx hardhat test",
    "compile": "npx hardhat compile",
    "deploy": "npx hardhat run scripts/deploy.ts",
    "deploy:chaido": "npx hardhat run scripts/deploy.ts --network chaido",
    "deploy:chaido:verify": "VERIFY=true npx hardhat run scripts/deploy.ts --network chaido",
    "deploy:gnosis": "npx hardhat run scripts/deploy.ts --network gnosis",
    "deploy:gnosis:verify": "VERIFY=true npx hardhat run scripts/deploy.ts --network gnosis",
    "deploy:sepolia": "npx hardhat run scripts/deploy.ts --network sepolia",
    "deploy:sepolia:verify": "VERIFY=true npx hardhat run scripts/deploy.ts --network sepolia",
    "deploy:v2": "npx hardhat run scripts/deploy-v2.ts",
    "deploy:v2:chaido": "npx hardhat run scripts/deploy-v2.ts --network chaido",
    "deploy:v2:chaido:verify": "VERIFY=true npx hardhat run scripts/deploy-v2.ts --network chaido",
    "deploy:v2:gnosis": "npx hardhat run scripts/deploy-v2.ts --network gnosis",
    "deploy:v2:gnosis:verify": "VERIFY=true npx hardhat run scripts/deploy-v2.ts --network gnosis",
    "deploy:v2:sepolia": "npx hardhat run scripts/deploy-v2.ts --network sepolia",
    "deploy:v2:sepolia:verify": "VERIFY=true npx hardhat run scripts/deploy-v2.ts --network sepolia",
    "verify:chaido": "npx hardhat run scripts/verify.ts --network chaido",
    "verify:gnosis": "npx hardhat run scripts/verify.ts --network gnosis",
    "verify:sepolia": "npx hardhat run scripts/verify.ts --network sepolia",
    "verify:v2:chaido": "npx hardhat run scripts/verify-v2.ts --network chaido",
    "verify:v2:gnosis": "npx hardhat run scripts/verify-v2.ts --network gnosis",
    "verify:v2:sepolia": "npx hardhat run scripts/verify-v2.ts --network sepolia",
    "node": "npx hardhat node"
  },
  "keywords": [
    "hardhat",
    "airdrop",
    "solidity",
    "ethereum"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.0",
    "hardhat": "^2.26.1",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "ethers": "^6.0.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
